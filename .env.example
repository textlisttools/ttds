# Copy this file to .env and fill it in. NEVER commit .env or share it.

# ---- Start here ------------------------------------------------------------
# true = fake data, nothing real happens. Set to false once your keys are in.
MOCK_MODE=true
# The public https address of this app (no trailing slash). Must match the
# redirect URLs you register with TikTok and AliExpress.
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///ttds.db

# Dashboard login — change these!
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me
# Any long random string, e.g. from: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ---- TikTok Shop Partner Center (see docs/API_KEYS.md) ---------------------
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SERVICE_ID=
# US shops: https://services.us.tiktokshop.com   Other regions: https://services.tiktokshop.com
TIKTOK_AUTHORIZE_BASE=https://services.us.tiktokshop.com
TIKTOK_CURRENCY=USD

# ---- AliExpress Open Platform (see docs/API_KEYS.md) -----------------------
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
SHIP_TO_COUNTRY=US
ALIEXPRESS_CURRENCY=USD
# Leave blank to use the cheapest/fastest option AliExpress offers.
ALIEXPRESS_LOGISTICS_SERVICE=

# ---- Your business rules ---------------------------------------------------
# Price = (AliExpress cost + shipping) x MARKUP_MULTIPLIER + MARKUP_FIXED, rounded to .99
MARKUP_MULTIPLIER=1.8
MARKUP_FIXED=2.0
# TikTok commission + payment fees as a fraction (check your Seller Center fee page)
TIKTOK_FEE_RATE=0.08
# Orders below this estimated profit are held for you to review
MIN_PROFIT=3.0
# false = you click Approve before anything is bought (recommended to start)
AUTO_ORDER=false
# Only import items shipping from SHIP_TO_COUNTRY and arriving within MAX_DELIVERY_DAYS
REQUIRE_LOCAL_WAREHOUSE=true
MAX_DELIVERY_DAYS=8
DEADLINE_WARNING_HOURS=24
MAX_LISTED_STOCK=20

# ---- How often background jobs run (minutes) -------------------------------
ORDER_POLL_MINUTES=10
TRACKING_POLL_MINUTES=60
MONITOR_POLL_MINUTES=180
